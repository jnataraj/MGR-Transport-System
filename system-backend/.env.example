# ============================================
# CTMS - Environment Variables (single .env)
# ============================================

# ---- Backend server ----
DATABASE_URL="postgresql://postgres:123@localhost:5432/ctms_db?schema=public"

JWT_SECRET=CTMS_SECRET_KEY
PORT=5000

# ---- CORS / Socket.IO allowed origins (used in app.js and server.js) ----
# Comma-separated, no spaces needed (spaces are trimmed automatically)
CLIENT_URLS=http://localhost:5173,http://localhost:8081,http://localhost:8082

# ---- Mobile app API base URL (used in api.js / AsyncStorage config file) ----
# Uncomment ONE line depending on where you're running the app from:

# For Expo Web:
EXPO_PUBLIC_API_URL=http://localhost:5000

# For Android Emulator (uncomment instead of the line above):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000

# For Physical Device on same Wi-Fi (uncomment instead, replace with your PC's LAN IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.100:5000