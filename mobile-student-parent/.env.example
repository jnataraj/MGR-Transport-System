# =============================================
# Student App (Expo) Environment Variables
# =============================================
# Change this URL when deploying to a different server.
# Variables must start with EXPO_PUBLIC_ to be accessible in the app.

# For local development (Expo Web):
EXPO_PUBLIC_API_URL=http://localhost:5000

# For Android Emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000

# For Physical Device (replace with your PC's local IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.100:5000

# For production / cloud deployment:
# EXPO_PUBLIC_API_URL=https://your-server.com
